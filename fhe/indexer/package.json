{
  "name": "@kakushi/fhe-indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Envio HyperIndex indexer for Kakushi Confidential (confidential payments on Monad)",
  "scripts": {
    "configure": "node scripts/configure.ts",
    "configure:testnet": "KAKUSHI_FHE_NETWORK=testnet node scripts/configure.ts",
    "codegen": "envio codegen",
    "dev": "envio dev",
    "start": "envio start",
    "test": "vitest run --test-timeout=20000",
    "typecheck": "tsc --noEmit",
    "activity": "node scripts/activity.ts"
  },
  "dependencies": {
    "envio": "3.14.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
