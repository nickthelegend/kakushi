# Public release mode. Local forks require explicit KAKUSHI_NETWORK=local off-host.
KAKUSHI_NETWORK=testnet
KAKUSHI_CONFIG_DIR=/app/config/generated
NEXT_PUBLIC_PRIVY_APP_ID=
KAKUSHI_ATTESTER_URL=
KAKUSHI_WATCHTOWER_URL=
KAKUSHI_INDEXER_URL=
# Optional Envio Hasura endpoint; the server keeps this endpoint out of browser config.
KAKUSHI_ENVIO_GRAPHQL_URL=
MONAD_TESTNET_RPC_URL=
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
